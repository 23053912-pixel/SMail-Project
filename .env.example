# SMail-Project Environment Variables
# Copy this file to .env and fill in values

# ── Google OAuth (required for real authentication) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Auth (required — server refuses to start without this) ─────────────────────
JWT_SECRET=

# ── ML Spam Detection API ─────────────────────────────────────────────────────
ML_API_HOST=localhost
ML_API_PORT=5001
# Shared secret for Node→Python API calls (optional, leave empty to disable)
ML_INTERNAL_TOKEN=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000
NODE_ENV=development
