{
  "name": "smail-project",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "test": "node --test backend/__tests__/emailHelpers.test.js backend/__tests__/email-crud.test.js backend/__tests__/email-scan.test.js",
    "docker:build": "docker build -t smail-backend:latest -f Dockerfile.backend .",
    "docker:build:ml": "docker build -t smail-ml-api:latest -f ml-engine/core/predictive/Dockerfile ./ml-engine/core/predictive",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "k8s:deploy": "kubectl apply -f k8s-gcp-deployment.yaml",
    "k8s:delete": "kubectl delete -f k8s-gcp-deployment.yaml"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.1",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "1.4.5-lts.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
